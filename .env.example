# Copy to .env.local and fill in. Never commit real values.

# Supabase (Task 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Server only)
# Primary designated provider: Groq with openai/gpt-oss-20b
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b

# Alternative provider: Gemini via Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=

# Public base URL of the deployed app (used when building share links)
APP_BASE_URL=http://localhost:3000

# Supabase CLI project ref (used by `npm run db:types` to generate types).
# Find this in the Supabase dashboard: Settings > General > Reference ID.
# Not needed at runtime — only for type generation.
SUPABASE_PROJECT_REF=

# Set to "true" to run the live RLS integration tests (tests/db/rls.test.ts).
# Requires NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, and
# anonymous sign-ins enabled in your Supabase project.
# SUPABASE_INTEGRATION_TEST=true

# Set to "1" to run live AI smoke tests (tests/ai/orchestrator.test.ts).
# Requires GROQ_API_KEY and network access.
# RUN_LIVE_AI=1
