# Copy to .env.local and fill in. Never commit real values.

# Supabase Auth & Database (Client-Safe: URL and anon key ONLY)
# Manual Supabase Dashboard Steps:
# 1. Enable Anonymous Sign-Ins in Auth > Sign In / Up > Anonymous Sign-Ins
# 2. Enable Email & Password provider in Auth > Providers > Email
# 3. Enable Google provider in Auth > Providers > Google (add redirect URI: ${origin}/auth/callback)
# 4. In Auth > URL Configuration, set Redirect URLs to include http://localhost:3000/** and your production domain
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. NEVER prefix with NEXT_PUBLIC_ and NEVER import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Server only)
# Ordered provider:model chain (tries in order; skips unkeyed providers)
AI_MODEL_CHAIN=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,google:gemini-3.1-flash-lite
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional OpenAI-compatible provider (disabled unless all 3 are set; HTTPS only)
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_LABEL=

# Public base URL of the deployed app (used when building share links)
APP_BASE_URL=http://localhost:3000

# Supabase CLI project ref (used by `npm run db:types` to generate types).
# Find this in the Supabase dashboard: Settings > General > Reference ID.
# Not needed at runtime — only for type generation.
SUPABASE_PROJECT_REF=

# Set to "true" to run the live RLS integration tests (tests/db/rls.test.ts).
# Requires NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, and
# anonymous sign-ins enabled in your Supabase project.
# SUPABASE_INTEGRATION_TEST=true

# Set to "1" to run live AI smoke tests (tests/ai/orchestrator.test.ts).
# Requires GROQ_API_KEY and network access.
# RUN_LIVE_AI=1
